@@ -0,0 +1,55 @@
+import base64
+import io
+from pathlib import Path
+import zipfile
+
+from scripts import package_project
+
+
+def create_sample_repo(tmp_path: Path) -> Path:
+    (tmp_path / "nested").mkdir()
+    (tmp_path / "nested" / "file.txt").write_text("hello")
+    (tmp_path / "ignored.log").write_text("ignore")
+    (tmp_path / "__pycache__").mkdir()
+    (tmp_path / "__pycache__" / "foo.pyc").write_bytes(b"binary")
+    (tmp_path / "dist").mkdir()
+    (tmp_path / "dist" / "old.zip").write_bytes(b"zip")
+    return tmp_path
+
+
+def test_collect_included_files_excludes_artifacts(tmp_path):
+    root = create_sample_repo(tmp_path)
+    files = package_project.collect_included_files(root)
+    relative = {path.relative_to(root).as_posix() for path in files}
+    assert "nested/file.txt" in relative
+    assert "ignored.log" not in relative
+    assert "dist/old.zip" not in relative
+    assert "__pycache__/foo.pyc" not in relative
+
+
+def test_create_archive(tmp_path):
+    root = create_sample_repo(tmp_path)
+    files = package_project.collect_included_files(root)
+    output = root / "dist" / "archive.zip"
+    package_project.create_archive(output, files, root, fmt="zip")
+
+    assert output.exists()
+
+    with zipfile.ZipFile(output) as zf:
+        names = set(zf.namelist())
+    assert names == {"nested/file.txt"}
+
+
+def test_create_archive_base64(tmp_path):
+    root = create_sample_repo(tmp_path)
+    files = package_project.collect_included_files(root)
+    output = root / "dist" / "archive.zip.b64"
+    package_project.create_archive(output, files, root, fmt="base64")
+
+    encoded = output.read_text(encoding="utf-8")
+    archive_bytes = base64.b64decode(encoded)
+
+    with zipfile.ZipFile(io.BytesIO(archive_bytes)) as zf:
+        names = set(zf.namelist())
+
+    assert names == {"nested/file.txt"}
