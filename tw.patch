+"""Ensure the repository remains free of tracked binary files."""
+
+from __future__ import annotations
+
+import subprocess
+from pathlib import Path
+
+import unittest
+
+
+class TestNoBinaryFiles(unittest.TestCase):
+    """Verifies that all tracked files are UTF-8 decodable text."""
+
+    def test_tracked_files_are_text(self) -> None:
+        repo_root = Path(__file__).resolve().parents[1]
+        result = subprocess.run(
+            ["git", "ls-files"],
+            cwd=repo_root,
+            check=True,
+            text=True,
+            capture_output=True,
+        )
+
+        binary_files: list[str] = []
+        for relative_path in result.stdout.splitlines():
+            tracked_file = repo_root / relative_path
+
+            # Skip directories or deleted paths that might appear in unusual git states.
+            if not tracked_file.is_file():
+                continue
+
+            with tracked_file.open("rb") as file_handle:
+                data = file_handle.read()
+
+            # Empty files are valid text assets.
+            if not data:
+                continue
+
+            try:
+                data.decode("utf-8")
+            except UnicodeDecodeError:
+                binary_files.append(relative_path)
+
+        self.assertFalse(binary_files, f"Binary files tracked in git: {binary_files}")
+
+
+if __name__ == "__main__":
+    unittest.main()
