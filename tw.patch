+"""Unit tests for the Terraform runner utilities."""
+from __future__ import annotations
+
+import tempfile
+import unittest
+from pathlib import Path
+
+from scripts import terraform_runner
+
+
+class ParseVariableFileTests(unittest.TestCase):
+    """Tests that exercise configuration parsing helpers."""
+
+    def test_parse_simple_key_value_file(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp_dir:
+            path = Path(tmp_dir) / "vars.yml"
+            path.write_text("""\n# comment\nregion: us-west-2\ncount: 3\nenabled: true\n""", encoding="utf-8")
+
+            values = terraform_runner._parse_variable_file(path)
+
+            self.assertEqual(values["region"], "us-west-2")
+            self.assertEqual(values["count"], "3")
+            self.assertEqual(values["enabled"], "true")
+
+    def test_parse_invalid_line_errors(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp_dir:
+            path = Path(tmp_dir) / "vars.yml"
+            path.write_text("invalid", encoding="utf-8")
+
+            with self.assertRaises(ValueError):
+                terraform_runner._parse_variable_file(path)
+
+    def test_missing_file_raises(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp_dir:
+            missing = Path(tmp_dir) / "does_not_exist.yml"
+            with self.assertRaises(FileNotFoundError):
+                terraform_runner._parse_variable_file(missing)
+
+
+class InlineVariableParsingTests(unittest.TestCase):
+    """Tests for command line variable overrides."""
+
+    def test_parse_inline_variables(self) -> None:
+        overrides = terraform_runner._parse_inline_variables(["foo=bar", "count=5"])
+        self.assertEqual(overrides, {"foo": "bar", "count": "5"})
+
+    def test_parse_inline_variables_rejects_missing_equals(self) -> None:
+        with self.assertRaises(ValueError):
+            terraform_runner._parse_inline_variables(["invalid"])
+
+    def test_parse_inline_variables_rejects_empty_key(self) -> None:
+        with self.assertRaises(ValueError):
+            terraform_runner._parse_inline_variables(["=value"])
+
+
+class LoadVariablesTests(unittest.TestCase):
+    """Tests for merging variable files."""
+
+    def test_load_variables_merges_ordered_files(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp_dir:
+            first = Path(tmp_dir) / "first.yml"
+            second = Path(tmp_dir) / "second.yml"
+            first.write_text("name: base\nregion: us-east-1\n", encoding="utf-8")
+            second.write_text("region: eu-west-1\n", encoding="utf-8")
+
+            values = terraform_runner._load_variables([first, second])
+
+            self.assertEqual(values["name"], "base")
+            # Second file overrides the region key
+            self.assertEqual(values["region"], "eu-west-1")
+
+
+if __name__ == "__main__":  # pragma: no cover - unittest CLI
+    unittest.main()
 
