new file mode 100644
index 0000000000000000000000000000000000000000..75be8154fcd6f277df9120a31b63f4e83996e2c5
--- /dev/null
+++ b/scripts/package_project.py
@@ -0,0 +1,159 @@
+"""Utility for packaging the repository into a distributable ZIP archive.
+
+The script omits typical build artifacts so the resulting archive only contains
+source files. It can be executed from the repository root:
+
+```
+python scripts/package_project.py --output dist/devops_sre.zip
+```
+"""
+from __future__ import annotations
+
+import argparse
+import base64
+import fnmatch
+import io
+import os
+from pathlib import Path
+import zipfile
+from typing import Iterable, List
+
+EXCLUDED_DIR_NAMES = {
+    ".git",
+    "__pycache__",
+    ".pytest_cache",
+    ".mypy_cache",
+    ".terraform",
+    ".terraform.d",
+    ".idea",
+    ".vscode",
+    "dist",
+}
+
+EXCLUDED_FILE_PATTERNS = [
+    "*.pyc",
+    "*.pyo",
+    "*.zip",
+    "*.tar",
+    "*.gz",
+    "*.tgz",
+    "*.xz",
+    "*.bz2",
+    "*.7z",
+    "*.log",
+    "*.tmp",
+]
+
+
+def _should_exclude_file(path: Path) -> bool:
+    """Return True when the file matches one of the excluded patterns."""
+    return any(fnmatch.fnmatch(path.name, pattern) for pattern in EXCLUDED_FILE_PATTERNS)
+
+
+def collect_included_files(root: Path) -> List[Path]:
+    """Return repository files that should be bundled into the archive."""
+    root = root.resolve()
+    collected: List[Path] = []
+
+    for current_dir, dirnames, filenames in os.walk(root):
+        # Mutate ``dirnames`` in place so ``os.walk`` skips the excluded directories.
+        dirnames[:] = [
+            name
+            for name in dirnames
+            if name not in EXCLUDED_DIR_NAMES
+        ]
+
+        for filename in filenames:
+            file_path = Path(current_dir, filename)
+            if _should_exclude_file(file_path):
+                continue
+
+            # Skip files that live inside an excluded directory which may have
+            # been included via a symlink or if the directory was added after we
+            # already recursed into it.
+            if any(part in EXCLUDED_DIR_NAMES for part in file_path.relative_to(root).parts[:-1]):
+                continue
+
+            collected.append(file_path)
+
+    collected.sort()
+    return collected
+
+
+def build_archive_bytes(files: Iterable[Path], root: Path) -> bytes:
+    """Return the raw ZIP bytes for *files* relative to *root*."""
+    root = root.resolve()
+    buffer = io.BytesIO()
+
+    with zipfile.ZipFile(buffer, "w", compression=zipfile.ZIP_DEFLATED) as archive:
+        for file_path in files:
+            arcname = file_path.relative_to(root).as_posix()
+            archive.write(file_path, arcname)
+
+    return buffer.getvalue()
+
+
+def create_archive(output: Path, files: Iterable[Path], root: Path, *, fmt: str = "zip") -> Path:
+    """Create an archive at *output* containing *files* relative to *root*."""
+
+    if fmt not in {"zip", "base64"}:
+        raise ValueError(f"Unsupported archive format: {fmt}")
+
+    output = output.resolve()
+    root = root.resolve()
+    output.parent.mkdir(parents=True, exist_ok=True)
+
+    archive_bytes = build_archive_bytes(files, root)
+
+    if fmt == "zip":
+        output.write_bytes(archive_bytes)
+    else:
+        encoded = base64.b64encode(archive_bytes).decode("ascii")
+        output.write_text(encoded, encoding="utf-8")
+
+    return output
+
+
+DEFAULT_OUTPUT = Path("dist/devops_sre.zip")
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description="Package the repository into a ZIP archive")
+    parser.add_argument(
+        "--output",
+        default=DEFAULT_OUTPUT,
+        type=Path,
+        help="Where to write the resulting archive (defaults to dist/devops_sre.zip)",
+    )
+    parser.add_argument(
+        "--root",
+        default=Path.cwd(),
+        type=Path,
+        help="Repository root to package (defaults to the current working directory)",
+    )
+    parser.add_argument(
+        "--format",
+        choices=("zip", "base64"),
+        default="zip",
+        help="Archive format to create. Use 'base64' to emit a text-safe archive",
+    )
+    return parser
+
+
+def main() -> Path:
+    parser = build_parser()
+    args = parser.parse_args()
+    files = collect_included_files(args.root)
+
+    output_path = args.output
+    if args.format == "base64" and args.output == DEFAULT_OUTPUT:
+        output_path = args.output.with_name(args.output.name + ".b64")
+
+    archive_path = create_archive(output_path, files, args.root, fmt=args.format)
+    descriptor = "base64 archive" if args.format == "base64" else "archive"
+    print(f"Created {descriptor} with {len(files)} files: {archive_path}")
+    return archive_path
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/terraform_runner.py b/scripts/terraform_runner.py
new file mode 100644
index 0000000000000000000000000000000000000000..26a799993f0db57d00fd3955185091ee12b62d2b
--- /dev/null
+++ b/scripts/terraform_runner.py
@@ -0,0 +1,216 @@
+#!/usr/bin/env python3
+"""Utility helpers to orchestrate Terraform workflows for AWS and Azure."""
+from __future__ import annotations
+
+import argparse
+import os
+import subprocess
+import sys
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Dict, Iterable, List, Mapping, Sequence
+
+try:  # pragma: no cover - optional dependency
+    import yaml  # type: ignore
+except Exception:  # pragma: no cover - PyYAML may not be installed
+    yaml = None  # type: ignore
+
+
+@dataclass(frozen=True)
+class TerraformWorkspace:
+    """Represents a Terraform configuration directory."""
+
+    name: str
+    path: Path
+
+    def exists(self) -> bool:
+        return self.path.is_dir()
+
+
+class TerraformCommandError(RuntimeError):
+    """Raised when a Terraform command fails."""
+
+
+class TerraformRunner:
+    """Wraps Terraform CLI invocations with helpful defaults."""
+
+    def __init__(self, workspace: TerraformWorkspace, *, dry_run: bool = False):
+        self.workspace = workspace
+        self.dry_run = dry_run
+
+    def run(
+        self,
+        action: str,
+        *,
+        auto_approve: bool = False,
+        variables: Dict[str, str] | None = None,
+    ) -> None:
+        if not self.workspace.exists():
+            raise FileNotFoundError(f"Terraform directory {self.workspace.path} does not exist")
+
+        cmd: List[str] = ["terraform", action]
+
+        if action in {"apply", "destroy"} and auto_approve:
+            cmd.append("-auto-approve")
+
+        if variables:
+            cmd.extend(_format_variable_args(variables))
+
+        self._execute(cmd)
+
+    def init(self, *, upgrade: bool = False) -> None:
+        cmd = ["terraform", "init"]
+        if upgrade:
+            cmd.append("-upgrade")
+        self._execute(cmd)
+
+    def _execute(self, cmd: List[str]) -> None:
+        if self.dry_run:
+            print("DRY-RUN:", " ".join(cmd))
+            return
+
+        try:
+            env = os.environ.copy()
+            env.setdefault("TF_IN_AUTOMATION", "true")
+            subprocess.run(cmd, cwd=self.workspace.path, check=True, env=env)
+        except subprocess.CalledProcessError as exc:  # pragma: no cover - CLI failure surface
+            raise TerraformCommandError(
+                f"Terraform command {' '.join(cmd)} failed with exit code {exc.returncode}"
+            ) from exc
+
+
+def _format_variable_args(values: Dict[str, str]) -> List[str]:
+    args: List[str] = []
+    for key, value in values.items():
+        args.extend(["-var", f"{key}={value}"])
+    return args
+
+
+def _discover_workspace(provider: str) -> TerraformWorkspace:
+    repo_root = Path(__file__).resolve().parent.parent
+    workspace_path = repo_root / provider / "terraform"
+    return TerraformWorkspace(name=provider, path=workspace_path)
+
+
+def _parse_variable_file(path: Path) -> Dict[str, str]:
+    if not path.exists():
+        raise FileNotFoundError(f"Variable file {path} does not exist")
+
+    contents = path.read_text(encoding="utf-8")
+
+    if yaml is not None:
+        loaded = yaml.safe_load(contents) or {}
+        if not isinstance(loaded, Mapping):
+            raise ValueError(f"Variable file {path} must contain a mapping of keys to values.")
+        return {
+            str(key): _coerce_scalar(value, key=str(key), source=path)
+            for key, value in loaded.items()
+        }
+
+    return _parse_key_value_lines(contents.splitlines(), source=path)
+
+
+def _parse_key_value_lines(lines: Sequence[str], *, source: Path) -> Dict[str, str]:
+    values: Dict[str, str] = {}
+    for raw_line in lines:
+        line = raw_line.strip()
+        if not line or line.startswith("#"):
+            continue
+        if ":" not in line:
+            raise ValueError(f"Invalid line '{raw_line}' in {source}; expected 'key: value'.")
+        key, value = line.split(":", 1)
+        values[key.strip()] = value.strip()
+    return values
+
+
+def _coerce_scalar(value: Any, *, key: str, source: Path) -> str:
+    if isinstance(value, bool):
+        return "true" if value else "false"
+    if isinstance(value, (int, float)):
+        return str(value)
+    if isinstance(value, str):
+        return value
+    raise ValueError(
+        f"Unsupported value type for key '{key}' in {source}: {type(value).__name__}. Only scalar values are allowed."
+    )
+
+
+def _load_variables(paths: Iterable[Path]) -> Dict[str, str]:
+    vars_combined: Dict[str, str] = {}
+    for path in paths:
+        vars_combined.update(_parse_variable_file(path))
+    return vars_combined
+
+
+def _parse_inline_variables(pairs: Iterable[str]) -> Dict[str, str]:
+    values: Dict[str, str] = {}
+    for pair in pairs:
+        if "=" not in pair:
+            raise ValueError(
+                f"Invalid --var argument '{pair}'. Expected the format key=value."
+            )
+        key, value = pair.split("=", 1)
+        if not key:
+            raise ValueError("Variable overrides must include a non-empty key.")
+        values[key] = value
+    return values
+
+
+def parse_args(argv: List[str]) -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description="Run Terraform against AWS or Azure configurations.")
+    parser.add_argument("provider", choices=["aws", "azure"], help="Cloud provider to target.")
+    parser.add_argument(
+        "action",
+        choices=["plan", "apply", "destroy"],
+        help="Terraform action to execute. Use 'plan' for read-only validation.",
+    )
+    parser.add_argument(
+        "--vars",
+        nargs="*",
+        type=Path,
+        default=[],
+        metavar="FILE",
+        help="Optional YAML files containing key-value pairs for -var overrides.",
+    )
+    parser.add_argument(
+        "--var",
+        dest="inline_vars",
+        action="append",
+        default=[],
+        metavar="KEY=VALUE",
+        help="Provide a single Terraform variable override. May be passed multiple times.",
+    )
+    parser.add_argument("--dry-run", action="store_true", help="Print commands without executing them.")
+    parser.add_argument("--auto-approve", action="store_true", help="Automatically approve apply/destroy actions.")
+    parser.add_argument("--init", action="store_true", help="Run 'terraform init' before the requested action.")
+    parser.add_argument(
+        "--upgrade",
+        action="store_true",
+        help="When used with --init, upgrades provider plugins to the newest allowed version.",
+    )
+    return parser.parse_args(argv)
+
+
+def main(argv: List[str] | None = None) -> int:
+    args = parse_args(argv or sys.argv[1:])
+
+    workspace = _discover_workspace(args.provider)
+    runner = TerraformRunner(workspace, dry_run=args.dry_run)
+
+    if args.init:
+        runner.init(upgrade=args.upgrade)
+
+    variables = _load_variables(args.vars) if args.vars else {}
+    if args.inline_vars:
+        variables.update(_parse_inline_variables(args.inline_vars))
+
+    try:
+        runner.run(args.action, auto_approve=args.auto_approve, variables=variables)
+    except (TerraformCommandError, FileNotFoundError, ValueError) as exc:
+        print(f"Error: {exc}", file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover - CLI entry point
+    sys.exit(main())
